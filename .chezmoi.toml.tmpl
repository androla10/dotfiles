{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $name  := promptStringOnce . "name" "User Name" -}}
{{- $default := output "hostname" -}}
{{- $hostName := promptStringOnce . "hostName" (printf "Host Name (default: %s)" $default) -}}

{{- if eq (trim $hostName) "" -}}
{{- fail (printf "Debes ingresar un Host Name (sugerido: %s)" $default) -}}
{{- end -}}

[data]
    email = {{ $email | quote }}
    name = {{ $name | quote }}
    hostName = {{ $hostName | quote }}
[scriptEnv]
    HOMEBREW_BUNDLE_FILE = "~/.private/Brewfile"