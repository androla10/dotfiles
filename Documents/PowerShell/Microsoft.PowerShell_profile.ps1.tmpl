{{ if eq .chezmoi.os "windows" }}
# Perfil de PowerShell personalizado para Windows
# Ruta deseada
$path = "C:\projects\mywork"

# Default Methods.
function GoToWork {
    try {
        # Verificar si la carpeta existe
        if (-not (Test-Path -Path $path -PathType Container)) {
            # Crear carpeta si no existe
            New-Item -Path $path -ItemType Directory -Force | Out-Null
            Write-Host "Directorio creado: $path"
        }

        # Cambiar ubicación
        Set-Location -Path $path

        if (-not $env:ZELLIJ) {
	        zellij
        }
    }
    catch {
        Write-Error "Error al crear o cambiar de directorio: $_"
    }
}

# Alias útiles
Set-Alias ll Get-ChildItem

# Variables de entorno
$env:EDITOR = "nvim"

# Forzar UTF-8
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8

# Habilitar secuencias ANSI si no están activas
$env:TERM = "xterm-256color"

function Get-VfoxCommand {
    $command = Get-Command vfox -ErrorAction SilentlyContinue
    if ($command) {
        return $command.Source
    }

    $candidatePaths = @(
        (Join-Path $env:LOCALAPPDATA "Microsoft\WinGet\Links\vfox.exe"),
        (Join-Path $env:LOCALAPPDATA "Programs\vfox\vfox.exe"),
        (Join-Path $env:ProgramFiles "vfox\vfox.exe")
    )

    foreach ($candidatePath in $candidatePaths) {
        if ($candidatePath -and (Test-Path $candidatePath)) {
            return $candidatePath
        }
    }

    return $null
}

$vfoxCommand = Get-VfoxCommand
if ($vfoxCommand) {
    $vfoxActivation = & $vfoxCommand activate pwsh
    if ($vfoxActivation) {
        Invoke-Expression $vfoxActivation
    }
}

{{ end }}