$chezmoiSource = "{{ .chezmoi.sourceDir }}"
Write-Host "chezmoi source path: $chezmoiSource" -ForegroundColor Cyan
Write-Host "chezmoi root path: $PSScriptRoot" -ForegroundColor Cyan

# install-java.ps1
$ErrorActionPreference = "Stop"

# ========================================
# Configuracion
# ========================================
$javaVersion = "{{ index (index .vfox.versions .machine.type) "java" }}"

function Get-VfoxCommand {
    $command = Get-Command vfox -ErrorAction SilentlyContinue
    if ($command) {
        return $command.Source
    }

    $candidatePaths = @(
        (Join-Path $env:LOCALAPPDATA "Microsoft\WinGet\Links\vfox.exe"),
        (Join-Path $env:LOCALAPPDATA "Programs\vfox\vfox.exe"),
        (Join-Path $env:ProgramFiles "vfox\vfox.exe")
    )

    foreach ($candidatePath in $candidatePaths) {
        if ($candidatePath -and (Test-Path $candidatePath)) {
            return $candidatePath
        }
    }

    return $null
}

$vfoxCommand = Get-VfoxCommand

Write-Host "========== Instalacion de Jav4 ==========" -ForegroundColor Cyan

# Verificar que vfox exista
if (-not $vfoxCommand) {
    Write-Error "vfox no esta instalado o no se encuentra en el PATH o en una ruta conocida."
    exit 1
}

# Verificar si el plugin de Java existe
$plugins = & $vfoxCommand available

if ($plugins -notmatch "java") {
    Write-Host "Instalando plugin Java..." -ForegroundColor Yellow
    & $vfoxCommand add java
}
else {
    Write-Host "Plugin Java ya instalado." -ForegroundColor Green
}

# Verificar si la version ya esta instalada
$installedVersions = & $vfoxCommand list java

if ($installedVersions -match [regex]::Escape($javaVersion)) {
    Write-Host "Java $javaVersion ya esta instalado." -ForegroundColor Green
}
else {
    Write-Host "Instalando Java $javaVersion..." -ForegroundColor Yellow
    & $vfoxCommand install java@$javaVersion
}

# Establecer version global
Write-Host "Configurando Java $javaVersion como version global..." -ForegroundColor Yellow
Write-Host "vfox use --global java@$javaVersion" -ForegroundColor Cyan
#& $vfoxCommand use --global java@$javaVersion

Write-Host ""
Write-Host "==========================================" -ForegroundColor Cyan
Write-Host "Java instalado correctamente." -ForegroundColor Green
Write-Host ""

# Actualizar el entorno para reflejar los cambios
& "$chezmoiSource\scripts\refresh-env.ps1"

