$chezmoiSource = "{{ .chezmoi.sourceDir }}"
Write-Host "chezmoi source path: $chezmoiSource" -ForegroundColor Cyan
Write-Host "chezmoi root path: $PSScriptRoot" -ForegroundColor Cyan

# install-maven.ps1
$ErrorActionPreference = "Stop"

# ========================================
# Configuración
# ========================================
$mavenVersion = "{{ index (index .vfox.versions .machine.type) "maven" }}"

function Get-VfoxCommand {
    $command = Get-Command vfox -ErrorAction SilentlyContinue
    if ($command) {
        return $command.Source
    }

    $candidatePaths = @(
        (Join-Path $env:LOCALAPPDATA "Microsoft\WinGet\Links\vfox.exe"),
        (Join-Path $env:LOCALAPPDATA "Programs\vfox\vfox.exe"),
        (Join-Path $env:ProgramFiles "vfox\vfox.exe")
    )

    foreach ($candidatePath in $candidatePaths) {
        if ($candidatePath -and (Test-Path $candidatePath)) {
            return $candidatePath
        }
    }

    return $null
}

$vfoxCommand = Get-VfoxCommand

Write-Host "========== Instalacion de Maven ==========" -ForegroundColor Cyan

# Verificar que vfox exista
if (-not $vfoxCommand) {
    Write-Error "vfox no está instalado o no se encuentra en el PATH o en una ruta conocida."
    exit 1
}

# Verificar si el plugin de Maven existe
$plugins = & $vfoxCommand available

if ($plugins -notmatch "maven") {
    Write-Host "Instalando plugin Maven..." -ForegroundColor Yellow
    & $vfoxCommand add maven
}
else {
    Write-Host "Plugin Maven ya instalado." -ForegroundColor Green
}

# Verificar si la versión ya está instalada
$installedVersions = & $vfoxCommand list maven

if ($installedVersions -match $mavenVersion) {
    Write-Host "Maven $mavenVersion ya está instalado." -ForegroundColor Green
}
else {
    Write-Host "Instalando Maven $mavenVersion..." -ForegroundColor Yellow
    & $vfoxCommand install maven@$mavenVersion
}

# Establecer versión global
Write-Host "Configurando Maven $mavenVersion como versión global..." -ForegroundColor Yellow
Write-Host "vfox use --global maven@$mavenVersion" -ForegroundColor Cyan
& $vfoxCommand use --global maven@$mavenVersion

Write-Host ""
Write-Host "==========================================" -ForegroundColor Cyan
Write-Host "Maven instalado correctamente." -ForegroundColor Green
Write-Host ""

# Actualizar el entorno para reflejar los cambios
& "$chezmoiSource\scripts\refresh-env.ps1"

